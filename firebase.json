{
  "hosting": {
    "public": "site",
    "ignore": ["firebase.json", "**/.*", "_mirror-report.json"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(css|js|woff|woff2|ttf|otf|eot|jpg|jpeg|png|gif|webp|avif|svg|ico|mp4|webm|json|lottie)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }]
      }
    ],
    "redirects": []
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
